# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored — never commit real credentials.

# --- Required ---
# MongoDB connection string. Atlas: mongodb+srv://<user>:<password>@<cluster>/<dbname>
# Local:  mongodb://127.0.0.1:27017/hrms
MONGODB_URI=

# --- Optional ---
# Signs session cookies. If unset, a secret is generated and stored in the database,
# so sessions survive restarts either way.
SESSION_SECRET=

# API port (default 3000 — the Vite dev proxy expects 3000).
PORT=3000

# Set to "production" on Render so session cookies are marked Secure.
NODE_ENV=development

# Public base URL used to build the links in nomination and attendance emails.
# In local development point this at the Vite dev server (http://localhost:5173),
# since that is where you actually open the app. Falls back to the request's own host.
APP_BASE_URL=http://localhost:5173

# Gmail SMTP for nomination and attendance emails (an App Password, not the account
# password). Leave blank to run without email: the app works fine, but "Send" and
# "Ask Who Attended" will fail — share links with the Copy Link button instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=
